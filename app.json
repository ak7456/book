{
  "expo": {
    "name": "Bookshelf",
    "slug": "bookshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bookshelf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bookshelf.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0EB"
      },
      "package": "com.bookshelf.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "카메라로 책의 바코드를 스캔합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "공유 카드를 갤러리에 저장합니다.",
          "savePhotosPermission": "공유 카드를 갤러리에 저장합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
